---
import { img } from '../lib';
import dims from '../data/img-dims.json';
interface Props { nome: string; alt: string; formato?: 'r43' | 'r34' | 'r169' | 'libero'; didascalia?: string; eager?: boolean; }
const { nome, alt, formato = 'r43', didascalia, eager = false } = Astro.props;
const [w, h] = (dims as Record<string, number[]>)[nome] ?? [];
---
<figure class="foto-fig">
  <div class:list={['foto', formato !== 'libero' && formato]}>
    <img src={img(nome)} alt={alt} width={w} height={h} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async" />
  </div>
  {didascalia && <figcaption>{didascalia}</figcaption>}
</figure>
<style>.foto-fig { margin: 0; min-width: 0; }</style>
