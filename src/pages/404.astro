---
import Base from '../layouts/Base.astro';
import { u } from '../lib';
---
<Base title="Pagina non trovata · Il Pettirosso" description="La pagina cercata non esiste.">
  <section class="sezione">
    <div class="wrap testo">
      <h1>Questa pagina non c'è</h1>
      <p class="lead">Il link potrebbe essere cambiato con il nuovo sito. Da qui puoi raggiungere le pagine principali.</p>
      <ul class="elenco">
        <li><a href={u('pensione-per-cani/')}>Pensione per cani</a></li>
        <li><a href={u('asilo-per-cani/')}>Asilo per cani</a></li>
        <li><a href={u('educazione-cinofila/')}>Educazione cinofila</a></li>
        <li><a href={u('contatti/')}>Contatti e orari</a></li>
      </ul>
      <div class="pulsanti"><a class="btn primario" href={u('')}>Torna alla home</a></div>
    </div>
  </section>
</Base>
