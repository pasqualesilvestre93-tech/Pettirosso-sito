---
import Base from '../layouts/Base.astro';
import Foto from '../components/Foto.astro';
import Video from '../components/Video.astro';
import InvitoVisita from '../components/InvitoVisita.astro';
import { img, u } from '../lib';
import dims from '../data/img-dims.json';

const foto = [
  { n: 'gallery-asilo-2025', t: 'Asilo cani 2025', f: 'r43' },
  { n: 'gallery-pacchia-relax', t: 'Momenti di relax', f: 'r43' },
  { n: 'gallery-denver-bimbo', t: 'Denver con il bambino', f: 'r43' },
  { n: 'gallery-mau-family-verde', t: 'Famiglia nel verde', f: 'r34' },
  { n: 'gallery-lucky-family', t: 'Lucky con la famiglia', f: 'r43' },
  { n: 'gallery-casch-family', t: 'Famiglia Casch', f: 'r34' },
  { n: 'gallery-elena-sally', t: 'Elena e Sally', f: 'r43' },
  { n: 'gallery-enzo-rosaria-snoopy', t: 'Enzo, Rosaria e Snoopy', f: 'r34' },
  { n: 'gallery-amira-sasa-family', t: 'Amira e Sasa con la famiglia', f: 'r43' },
  { n: 'gallery-monica-federica-titti', t: 'Monica, Federica e Titti', f: 'r34' },
  { n: 'gallery-mauy-family', t: 'Mauy con la famiglia', f: 'r43' },
  { n: 'gallery-lucky-dalmata', t: 'Lucky il dalmata', f: 'r34' },
  { n: 'gallery-amira-cucciola', t: 'Amira cucciola', f: 'r34' },
  { n: 'gallery-mauy', t: 'Ritratto di Mauy', f: 'r34' },
  { n: 'gallery-casch', t: 'Casch', f: 'r34' },
  { n: 'gallery-denver', t: 'Denver', f: 'r34' },
  { n: 'gallery-flv-2255-migliorato-nr', t: 'Ritratto del cane', f: 'r43' },
  { n: 'gallery-obbedienza', t: 'Obbedienza in campo', f: 'r43' },
  { n: 'gallery-aisha-adri', t: 'Aisha e Adri', f: 'r34' },
  { n: 'gallery-dsc04102', t: '', f: 'r34' },
  { n: 'gallery-dsc02967-copia-1', t: '', f: 'r43' },
  { n: 'gallery-pranzo-gruppo', t: 'I nostri amici a pranzo', f: 'r43' },
  { n: 'gallery-cosa-facciamo--piscina', t: 'Giochi in piscina', f: 'r43' },
  { n: 'gallery-cosa-facciamo--bambini-e-cani-1', t: 'Bambini e cani', f: 'r43' },
] as const;
const passato = ['york-passato-2', 'york-passato-3', 'york-passato-5', 'york-passato-7'];
const misure = (n: string) => (dims as Record<string, number[]>)[n] ?? [];
const grande = (n: string) => (misure(n)[0] > 900 ? `${u(`img/${n}-800.webp`)} 800w, ${img(n)} ${misure(n)[0]}w` : undefined);
---
<Base briciole={[{ nome: 'Gallery', href: 'gallery/' }]} title="Gallery · Centro Cinofilo Il Pettirosso" description="Foto e video dal Centro Cinofilo Il Pettirosso: cani ospiti, famiglie, asilo, seminari e momenti del passato." image="gallery-asilo-2025">
  <section class="sezione stretta">
    <div class="wrap">
      <h1>Momenti dal Pettirosso</h1>
      <p class="lead">Una raccolta di momenti catturati durante le nostre attività: cani ospiti, famiglie, il verde che ci circonda.</p>
    </div>
  </section>

  <section class="sezione stretta">
    <div class="wrap galleria">
      {foto.map((x) => (
        <a class="apri" href={img(x.n)} data-srcset={grande(x.n)} data-w={misure(x.n)[0]} data-h={misure(x.n)[1]} data-didascalia={x.t}>
          <Foto nome={x.n} alt={x.t || 'Un momento al campo del Pettirosso'} formato={x.f} didascalia={x.t || undefined} sizes="(max-width: 640px) 50vw, 280px" />
        </a>
      ))}
    </div>
  </section>

  <section class="sezione fascia">
    <div class="wrap">
      <h2>Con il Gruppo Cinofilo dei Carabinieri</h2>
      <div class="griglia-2" style="align-items:start">
        <Video nome="carabinieri-cinofili-1" verticale />
        <Video nome="carabinieri-cinofili-2" verticale />
      </div>
    </div>
  </section>

  <section class="sezione">
    <div class="wrap">
      <h2>Formazione al campo</h2>
      <div class="griglia-2" style="align-items:start">
        <Video nome="seminario-luigi-di-leo" didascalia="Seminario con Luigi di Leo." />
        <div class="griglia-2 coppia">
          <Foto nome="seminario-vitalini-1" alt="Seminario con Ivano Vitalini, attività con cane" formato="r43" />
          <Foto nome="seminario-vitalini-2" alt="Seminario con Ivano Vitalini, esercizio di mobility" formato="r43" />
          <Foto nome="seminario-vitalini-3" alt="Seminario con Ivano Vitalini, foto di gruppo" formato="r43" />
          <Foto nome="seminario-vitalini-locandina" alt="Locandina del seminario con Ivano Vitalini" formato="r43" />
        </div>
      </div>
      <p class="nota">Seminario con Ivano Vitalini: «Muovere il corpo per muovere la mente».</p>
    </div>
  </section>

  <section class="sezione fascia">
    <div class="wrap">
      <h2>L'unica differenza… era la coda.</h2>
      <div class="griglia-4">
        {passato.map((n) => <Foto nome={n} alt="Ferdinando da giovane con il suo cane" formato="r34" />)}
      </div>
    </div>
  </section>

  <InvitoVisita />

  <dialog class="visore" aria-label="Foto ingrandita">
    <figure>
      <figcaption><span class="conta"></span> <span class="testo-didascalia"></span></figcaption>
    </figure>
    <button class="v-chiudi" type="button" aria-label="Chiudi la foto">
      <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15" /></svg>
    </button>
    <button class="v-freccia v-prec" type="button" aria-label="Foto precedente">
      <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M12.5 4l-6 6 6 6" /></svg>
    </button>
    <button class="v-freccia v-succ" type="button" aria-label="Foto successiva">
      <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M7.5 4l6 6-6 6" /></svg>
    </button>
  </dialog>
</Base>

<script>
  // Visore della gallery: senza JS il link apre la foto; con JS si apre il dialog,
  // e dove il browser lo supporta la miniatura si ingrandisce fino alla foto grande.
  const voci = [...document.querySelectorAll<HTMLAnchorElement>('.galleria .apri')];
  const visore = document.querySelector<HTMLDialogElement>('.visore');
  if (visore && voci.length) {
    const foto = document.createElement('img');
    const conta = visore.querySelector('.conta')!;
    const didascalia = visore.querySelector('.testo-didascalia')!;
    const ridotto = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const transizione = (aggiorna: () => void) => {
      if (ridotto || !document.startViewTransition) { aggiorna(); return Promise.resolve(); }
      document.documentElement.classList.add('vt-visore');
      return document.startViewTransition(aggiorna).finished.finally(() => document.documentElement.classList.remove('vt-visore'));
    };
    const miniatura = (i: number) => voci[i].querySelector<HTMLElement>('.foto')!;
    let attuale = 0;

    const mostra = (i: number) => {
      attuale = (i + voci.length) % voci.length;
      const v = voci[attuale];
      foto.src = v.href;
      if (v.dataset.srcset) { foto.srcset = v.dataset.srcset; foto.sizes = '92vw'; } else { foto.removeAttribute('srcset'); }
      foto.width = Number(v.dataset.w) || 0;
      foto.height = Number(v.dataset.h) || 0;
      foto.alt = v.querySelector('img')?.alt ?? '';
      if (!foto.isConnected) visore.querySelector('figure')!.prepend(foto);
      conta.textContent = `${attuale + 1} di ${voci.length}`;
      didascalia.textContent = v.dataset.didascalia ?? '';
    };

    const apri = (i: number) => {
      const m = miniatura(i);
      m.style.viewTransitionName = 'zoom';
      transizione(() => {
        m.style.viewTransitionName = '';
        foto.style.viewTransitionName = 'zoom';
        mostra(i);
        visore.showModal();
      }).finally(() => { foto.style.viewTransitionName = ''; });
    };

    const chiudi = () => {
      foto.style.viewTransitionName = 'zoom';
      const m = miniatura(attuale);
      transizione(() => {
        foto.style.viewTransitionName = '';
        m.style.viewTransitionName = 'zoom';
        visore.close();
      }).finally(() => { m.style.viewTransitionName = ''; voci[attuale].focus(); });
    };

    voci.forEach((v, i) => v.addEventListener('click', (e) => {
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
      e.preventDefault();
      apri(i);
    }));
    visore.querySelector('.v-chiudi')!.addEventListener('click', chiudi);
    visore.querySelector('.v-prec')!.addEventListener('click', () => mostra(attuale - 1));
    visore.querySelector('.v-succ')!.addEventListener('click', () => mostra(attuale + 1));
    visore.addEventListener('cancel', (e) => { e.preventDefault(); chiudi(); });
    visore.addEventListener('click', (e) => { if (e.target === visore) chiudi(); });
    visore.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') mostra(attuale - 1);
      if (e.key === 'ArrowRight') mostra(attuale + 1);
    });
  }
</script>
<style>
  .galleria { display: grid; gap: 1rem; grid-template-columns: repeat(4, minmax(0, 1fr)); align-items: start; }
  @media (max-width: 900px) { .galleria { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .galleria { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .apri { display: block; color: inherit; text-decoration: none; border-radius: var(--raggio); cursor: zoom-in; }
  .apri:hover img { filter: brightness(1.05); }
  .coppia { gap: 0.75rem; }

  .visore { border: 0; padding: 0; margin: auto; width: 100vw; height: 100dvh; max-width: none; max-height: none; background: transparent; color: var(--crema); }
  .visore::backdrop { background: rgba(43, 33, 28, 0.96); }
  .visore figure { margin: 0; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 4.25rem 4.5rem 1.25rem; gap: 0.75rem; }
  .visore img { max-width: 100%; max-height: calc(100dvh - 9rem); width: auto; height: auto; object-fit: contain; border-radius: 8px; }
  .visore figcaption { color: #EFE4D8; font-size: var(--t-s); text-align: center; margin: 0; }
  .visore .conta { opacity: 0.8; margin-right: 0.5rem; font-variant-numeric: tabular-nums; }
  .visore button { position: absolute; width: 48px; height: 48px; border-radius: 50%; border: 1px solid rgba(249, 245, 240, 0.35); background: rgba(43, 33, 28, 0.6); color: var(--crema); display: grid; place-items: center; cursor: pointer; padding: 0; }
  .visore button:hover { background: rgba(43, 33, 28, 0.9); }
  .visore button svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .v-chiudi { top: 1rem; right: 1rem; }
  .v-freccia { top: 50%; translate: 0 -50%; }
  .v-prec { left: 1rem; }
  .v-succ { right: 1rem; }
  @media (max-width: 640px) {
    .visore figure { padding: 4.25rem 0.75rem 5.5rem; }
    .visore img { max-height: calc(100dvh - 13rem); }
    .v-freccia { top: auto; bottom: 1.25rem; translate: none; }
    .v-prec { left: calc(50% - 60px); }
    .v-succ { right: calc(50% - 60px); }
  }
  @media (prefers-reduced-motion: no-preference) {
    .visore[open], .visore[open]::backdrop { animation: entra-visore 0.25s ease both; }
  }
  @keyframes entra-visore { from { opacity: 0; } }
  @media (max-width: 720px) { .coppia { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
<style is:global>
  /* Durante lo zoom la pagina resta ferma; la foto si ritaglia invece di deformarsi. */
  html.vt-visore::view-transition-old(root), html.vt-visore::view-transition-new(root) { animation: none; }
  ::view-transition-old(zoom), ::view-transition-new(zoom) { width: 100%; height: 100%; object-fit: cover; }
</style>
